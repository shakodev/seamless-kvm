<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeamlessKVM" Width="760" Height="790" MinWidth="650" MinHeight="720"
        Background="#F4F3EF" Foreground="#252A28" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#68716C"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="17,10"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#252A28"/>
      <Setter Property="BorderBrush" Value="#D5D9D2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#396B57"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#D5D9D2"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid Margin="32,26,32,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,25">
      <TextBlock DockPanel.Dock="Right" Text="WINDOWS HOST" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      <TextBlock Text="SeamlessKVM" FontSize="25" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#E7EBE4" CornerRadius="8" Padding="22,20" Margin="0,0,0,25">
      <DockPanel>
        <Button x:Name="Start" DockPanel.Dock="Right" Content="_Start server" Background="#315D4B" Foreground="White" BorderBrush="#315D4B" MinWidth="135" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Fill="#88928B" Width="8" Height="8" Margin="0,0,9,0"/>
            <TextBlock x:Name="Status" Text="Stopped" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <TextBlock x:Name="StatusDetail" Text="Build the host to get started" Foreground="{StaticResource Muted}" Margin="17,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,24">
      <DockPanel Margin="0,0,0,10">
        <Button x:Name="Pair" DockPanel.Dock="Right" Content="Create _pairing…" Padding="10,4" FontSize="12"/>
        <TextBlock Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel>
        <Button x:Name="Browse" DockPanel.Dock="Right" Content="_Browse…" Margin="8,0,0,0"/>
        <TextBox x:Name="ConfigPath" IsReadOnly="True" AutomationProperties.Name="Host configuration" Text="No configuration selected" TextWrapping="NoWrap"/>
      </DockPanel>
      <Grid x:Name="Settings" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Label Target="{Binding ElementName=Listen}" Content="Listen address" Padding="0,0,0,6" FontSize="12" Foreground="{StaticResource Muted}"/>
          <ComboBox x:Name="Listen" IsEditable="True" Padding="8,8" AutomationProperties.Name="Listen address"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Target="{Binding ElementName=Monitor}" Content="Windows display" Padding="0,0,0,6" FontSize="12" Foreground="{StaticResource Muted}"/>
          <ComboBox x:Name="Monitor" Padding="8,8" AutomationProperties.Name="Windows display"/>
        </StackPanel>
        <Button x:Name="Save" Grid.Column="3" Content="_Save" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Release build" FontWeight="SemiBold"/>
        <TextBlock x:Name="BuildDetail" Text="Not built" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="Check" Content="_Check" Margin="0,0,8,0" ToolTip="Check configuration and native input setup"/>
        <Button x:Name="Build" Content="_Build" Margin="0,0,8,0"/>
        <Button x:Name="Rebuild" Content="_Rebuild" ToolTip="Stop the server, clean the host package, and build again"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,9">
        <Button x:Name="Clear" DockPanel.Dock="Right" Content="Clear" FontSize="12" Padding="8,2" Background="Transparent" BorderThickness="0"/>
        <TextBlock Text="Activity" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="#D5D9D2" BorderThickness="1" CornerRadius="5" Background="#FAFAF7">
        <TextBox x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" Padding="12" AutomationProperties.Name="Activity log"/>
      </Border>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,18,0,0">
      <TextBlock DockPanel.Dock="Right" Text="Ctrl + Alt + Shift + F12" FontSize="12" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Restore local control" FontSize="12" Foreground="{StaticResource Muted}"/>
    </DockPanel>
  </Grid>
</Window>
